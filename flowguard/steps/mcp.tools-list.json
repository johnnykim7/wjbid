{
  "type": "ACTION",
  "name": "MCP tools/list — 8개 Tool 등록 확인",
  "connector": "bidding-api",
  "action": {
    "method": "POST",
    "endpoint": "/api/mcp",
    "headers": { "Content-Type": "application/json" },
    "body": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "tools/list"
    }
  },
  "assert": [
    { "field": "$.statusCode", "operator": "==", "value": 200 },
    { "field": "$.body.result.tools.length", "operator": "==", "value": 8 }
  ],
  "failMode": "hard"
}
