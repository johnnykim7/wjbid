{
  "type": "ACTION",
  "name": "입찰 문서 목록 조회",
  "connector": "bidding-api",
  "action": {
    "method": "GET",
    "endpoint": "/api/bid-requests/{{steps.bid.create-request.output.bidRequestId}}/documents",
    "headers": {
      "Authorization": "Bearer {{vars.adminToken}}"
    }
  },
  "extract": {
    "documentId": "$.body.data[0].id"
  },
  "assert": [
    { "field": "$.statusCode", "operator": "==", "value": 200 },
    { "field": "$.body.success", "operator": "==", "value": true }
  ],
  "failMode": "soft"
}
