{
  "type": "ACTION",
  "name": "문서 템플릿 목록 조회",
  "connector": "bidding-api",
  "action": {
    "method": "GET",
    "endpoint": "/api/admin/document-templates",
    "headers": {
      "Authorization": "Bearer {{vars.adminToken}}"
    }
  },
  "extract": {
    "templateId": "$.body.data[0].id"
  },
  "assert": [
    { "field": "$.statusCode", "operator": "==", "value": 200 },
    { "field": "$.body.success", "operator": "==", "value": true }
  ],
  "failMode": "soft"
}
