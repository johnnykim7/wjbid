{
  "type": "UI_SMOKE",
  "name": "[Admin] 공고 수집 관리 렌더링",
  "connector": "admin-console",
  "action": {
    "url": "http://localhost:5174/collection",
    "waitForSelector": "main",
    "auth": {
      "type": "localStorage",
      "key": "accessToken",
      "value": "{{vars.adminPortalToken}}"
    }
  },
  "assert": [
    { "field": "$.statusCode", "operator": "==", "value": 200 }
  ],
  "failMode": "soft"
}
