{
  "type": "ACTION",
  "name": "MCP get_bid_request Tool 호출",
  "connector": "bidding-api",
  "action": {
    "method": "POST",
    "endpoint": "/api/mcp",
    "headers": { "Content-Type": "application/json" },
    "body": {
      "jsonrpc": "2.0",
      "id": 5,
      "method": "tools/call",
      "params": {
        "name": "get_bid_request",
        "arguments": { "bidRequestId": "{{steps.bid.create-request.output.bidRequestId}}" }
      }
    }
  },
  "assert": [
    { "field": "$.statusCode", "operator": "==", "value": 200 },
    { "field": "$.body.result.content", "operator": "!=", "value": null },
    { "field": "$.body.result.isError", "operator": "!=", "value": true }
  ],
  "failMode": "hard"
}
