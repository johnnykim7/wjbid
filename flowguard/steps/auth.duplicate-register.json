{
  "type": "ACTION",
  "name": "BIZ-008 중복 이메일 가입 거부",
  "connector": "bidding-api",
  "action": {
    "method": "POST",
    "endpoint": "/api/auth/register",
    "headers": { "Content-Type": "application/json" },
    "body": {
      "email": "{{steps.auth.register.output.email}}",
      "password": "Test1234!@",
      "companyName": "Duplicate Corp"
    }
  },
  "assert": [
    { "field": "$.statusCode", "operator": "!=", "value": 200 },
    { "field": "$.body.success", "operator": "==", "value": false }
  ],
  "failMode": "hard"
}
