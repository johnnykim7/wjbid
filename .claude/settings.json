{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": ".claude/hooks/enforce-workflow.sh" }]
      },
      {
        "matcher": "Edit",
        "hooks": [{ "type": "command", "command": ".claude/hooks/enforce-workflow.sh" }]
      },
      {
        "matcher": "Write",
        "hooks": [{ "type": "command", "command": ".claude/hooks/enforce-workflow.sh" }]
      }
    ]
  }
}
