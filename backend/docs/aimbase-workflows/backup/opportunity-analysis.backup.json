        },
        "steps": [
            {
                "id": "fetch_opportunity",
                "name": "\uacf5\uace0 \uc815\ubcf4 \ubd88\ub7ec\uc624\ub294 \uc911",
                "type": "TOOL_CALL",
                "config": {
                    "tool": "get_opportunity",
                    "input": {
                        "opportunityId": "{{input.opportunityId}}"
                    }
                },
                "depends_on": []
            },
            {
                "id": "write_description",
                "name": "\uacf5\uace0 \ubcf8\ubb38 \uc900\ube44 \uc911",
                "type": "TOOL_CALL",
                "config": {
                    "tool": "file_write",
                    "input": {
                        "content": "{{input.opportunityText}}",
                        "file_path": "description.txt",
                        "overwrite": true
                    }
                },
                "depends_on": [
                    "fetch_opportunity"
                ]
            },
            {
                "id": "download_attachments",
                "name": "\ucca8\ubd80\ud30c\uc77c \ubc1b\ub294 \uc911",
                "type": "FOREACH",
                "config": {
                    "body": {
                        "type": "TOOL_CALL",
                        "config": {
                            "tool": "download_file",
                            "input": {
                                "url": "{{item.downloadUrl}}",
                                "file_path": "attachments/{{item.fileName}}",
                                "overwrite": true
                            }
                        }
                    },
                    "mode": "parallel",
                    "items": "{{input.attachmentFiles}}",
                    "collect": "append",
                    "item_var": "item",
                    "max_items": 60,
                    "on_item_error": "continue",
                    "max_concurrency": 4
                },
                "depends_on": [
                    "fetch_opportunity"
                ]
            },
            {
                "id": "extract_facts",
                "name": "\uacf5\uace0 \ub0b4\uc6a9 \ubd84\uc11d \uc911",
                "type": "AGENT_CALL",
                "config": {
                    "prompt": "\ub2f9\uc2e0\uc740 \ubbf8\uad70(USFK) \uc815\ubd80\uc870\ub2ec RFP \ubd84\uc11d \uc804\ubb38\uac00\uc785\ub2c8\ub2e4. \uc791\uc5c5\uc7a5(workspace)\uc5d0 \uacf5\uace0 \ubcf8\ubb38\uacfc \ucca8\ubd80 \uc6d0\ubcf8 \ud30c\uc77c\uc774 \uc801\uc7ac\ub3fc \uc788\uc2b5\ub2c8\ub2e4. \uc9c1\uc811 \uc77d\uc5b4 \ubd84\uc11d\ud558\uc138\uc694.\n\n[1\ub2e8\uacc4 \u2014 \uc790\ub8cc \uc77d\uae30 (\ud55c \ubc88\uc529\ub9cc, \uc7ac\ub3c5 \uae08\uc9c0)]\n1. `ls attachments/` \ub85c \ucca8\ubd80 \ubaa9\ub85d\u00b7\uac1c\uc218 N \ud655\uc778.\n2. `description.txt` + attachments/ \uc758 N\uac1c \ud30c\uc77c\uc744 **\uac01\uac01 \ud55c \ubc88\uc529\ub9cc** \uc77d\ub294\ub2e4. \ud55c \ud30c\uc77c\uc740 \ucc98\uc74c\ubd80\ud130 \ub05d\uae4c\uc9c0 \uc21c\uc11c\ub300\ub85c \uc77d\uace0, **\uc774\ubbf8 \uc77d\uc740 \ud30c\uc77c\u00b7\ud398\uc774\uc9c0\ub294 \uc808\ub300 \ub2e4\uc2dc \uc77d\uc9c0 \uc54a\ub294\ub2e4**(\uac19\uc740 \uac83\uc744 \uc7ac\ud655\uc778\ud558\ub824 \ub418\uc77d\uc9c0 \ub9d0 \uac83 \u2014 \uc2dc\uac04\ub9cc \ub0ad\ube44\ub41c\ub2e4).\n   - \ub300\uc6a9\ub7c9 PDF: Read \uac00 'too many pages / Maximum 20 pages per request' \ub85c \uac70\ubd80\ub418\uba74, `pages:\"1-20\"\u2192\"21-40\"\u2192...\u2192\ub9c8\uc9c0\ub9c9`\uae4c\uc9c0 20p\uc529 \uc21c\uc11c\ub300\ub85c \ub098\ub220 \ud55c \ubc88\uc529 \uc77d\ub294\ub2e4(180p\uba74 9\ubb36\uc74c). \uac70\ubd80\ub410\ub2e4\uace0 \uadf8 \ud30c\uc77c\uc744 \uac74\ub108\ub6f0\uc9c0 \ub9d0 \uac83.\n   - \ube44\uc5c8\uac70\ub098 \uc548 \uc77d\ud788\ub294 \ud30c\uc77c\uc740 \ube48\uce78 \ucc98\ub9ac(\ucd94\uce21 \uae08\uc9c0).\n3. \ubaa8\ub4e0 \ud30c\uc77c\uc744 \ud55c \ubc88\uc529 \ub2e4 \uc77d\uc5c8\uc73c\uba74 **\uace7\ubc14\ub85c 2\ub2e8\uacc4 \ubd84\uc11d\uc73c\ub85c \ub118\uc5b4\uac04\ub2e4.** \ub2e4\uc2dc \uc77d\uc73c\uba70 \uac80\uc99d\ud558\uc9c0 \ub9d0 \uac83 \u2014 \uac80\uc99d\uc740 \ub2e4\uc74c STEP(verify) \ub2f4\ub2f9\uc774\ub2e4.\n\n[\uacf5\uace0 \uba54\ud0c0]\n{{fetch_opportunity.output}}\n\n[2\ub2e8\uacc4 \u2014 \ubd84\uc11d]\n1. \ud55c\uad6d PM/\uc601\uc5c5\uc774 \uc774\ud574\ud560 \ud55c\uad6d\uc5b4\ub85c \uacf5\uace0 \ud575\uc2ec\uc744 \ubd84\uc11d. \ud56d\ubaa9: \ud55c\uad6d\uc5b4 \uc81c\ubaa9 / \ud575\uc2ec\uc694\uc57d(overview) / \uc791\uc5c5\ubc94\uc704(scope, PWS\uae30\ubc18) / \uacc4\uc57d\uae30\uac04(contractPeriod: \uc218\ud589\uae30\uac04\u00b7\uae30\ucd08/\uc635\uc158\uc5f0\ucc28 \ub4f1) / \ud604\uc7a5\uc124\uba85\ud68c(siteVisit: \uc77c\uc2dc\u00b7\uc7a5\uc18c\u00b7\ud544\uc218\uc5ec\ubd80, \uc5c6\uc73c\uba74 \ube48\uce78) / \ucc38\uc5ec\uc790\uaca9(eligibility) / \ud3c9\uac00\uae30\uc900(evaluationCriteria, LPTA\u00b7BestValue) / \uc8fc\uc694\uc77c\uc815(keyDates: \ub77c\ubca8\u00b7\ub0a0\uc9dc\u00b7\ube44\uace0) / \uc608\uc0b0(budgetInfo) / \ud2b9\uc774\uc0ac\ud56d(specialNotes) / \uc81c\ucd9c\uc11c\ub958 / \uc591\uc2dd / \ub2f4\ub2f9\uc790(contactInfo, POC).\n2. \uc815\ubd80\uc870\ub2ec \uace8\uaca9\ub300\ub85c \uc81c\ucd9c\uc11c\ub958\ub97c FACTOR>Subfactor \uacc4\uce35\uc73c\ub85c \ucd94\ucd9c. \uac01 Subfactor \uc758 \ucda9\uc871\uc8fc\uccb4(fulfillmentParty)\ub97c \ud310\ub2e8: \ud2b8\ub7ed/\uc7a5\ube44/\uc778\ub825/\uacfc\uac70\uc2e4\uc801 \uc99d\ube59=CLIENT_UPLOAD, \ud50c\ub7ab\ud3fc\uc774 \uc791\uc131\ud558\ub294 \uae30\uc220\u00b7\uac00\uaca9 \uc81c\uc548=PLATFORM_GENERATED, \uc815\ubd80\uc591\uc2dd=SYSTEM_FORM. (Sub-Factor \uac00 \ud2b8\ub7ed\u00b7\uc778\ub825 \ubcf4\uc720\ub97c \uc694\uad6c\ud558\uba74 \ubc18\ub4dc\uc2dc CLIENT_UPLOAD)\n3. \uc790\uaca9\uc694\uac74(eligibility)\uc744 \ubcc4\ub3c4 \ucd94\ucd9c: title/description/mandatory/evidenceBy/isGate.\n4. \u2605\uadfc\uac70 \ubd80\ucc29(\ud575\uc2ec)\u2605: \ucd94\ucd9c\ud55c \ubaa8\ub4e0 \uc0ac\uc2e4(fact)\uc5d0 \uadf8 \uadfc\uac70\uac00 \ub41c \uc791\uc5c5\uc7a5 \ud30c\uc77c\uacfc \uc6d0\ubb38 \uc778\uc6a9\uc744 \ub0a8\uae30\uc138\uc694. \uac01 fact = { key(\ud56d\ubaa9\uba85), value(\ucd94\ucd9c\uac12), sourceFile(\uc791\uc5c5\uc7a5 \ud30c\uc77c\uba85, \uc608: 'description.txt' \ub610\ub294 'attachments/<\ud30c\uc77c\uba85>'), sourceQuote(\uc6d0\ubb38 1~2\ubb38\uc7a5 \uadf8\ub300\ub85c), page(\uc788\uc73c\uba74), confidence(HIGH/MEDIUM/LOW) }\n\n[\u2605\uc904\ubc14\uafc8 \uaddc\uce59 (\uac00\ub3c5\uc131, \ud544\uc218)\u2605]\n\ud558\ub098\uc758 string \ud544\ub4dc(siteVisit\u00b7contractPeriod\u00b7scope\u00b7overview\u00b7specialNotes\u00b7budgetInfo\u00b7\uc81c\ucd9c\uc11c\ub958 notes/description \ub4f1)\uc5d0 \uc77c\uc2dc/\uc7a5\uc18c/\ube44\uace0\ucc98\ub7fc \uc5ec\ub7ec \uc815\ubcf4\ub97c \ub2f4\uc744 \ub54c, `/`\u00b7`|`\u00b7` - ` \uac19\uc740 \uad6c\ubd84\uc790\ub85c \ud55c \uc904\uc5d0 \uc787\uc9c0 \ub9d0\uace0 \uac01 \uc815\ubcf4\ub97c \uc2e4\uc81c \uc904\ubc14\uafc8 \ubb38\uc790(\\n)\ub85c \ubd84\ub9ac\ud558\ub77c.\n\uc608) siteVisit = \"\uc77c\uc2dc: 2026-07-01(\uc218) 09:00\\n\uc7a5\uc18c: \uc624\uc0b0 \uacf5\uad70\uae30\uc9c0 600\ub3d9 \uc55e \uc9d1\ud569\\n\ube44\uace0: \uc0ac\uc804 \ud604\uc7a5\ubc29\ubb38, \ucc38\uc11d \uac15\ub825 \uad8c\uc7a5\".\n\ubc88\ud638 \uc5f4\uac70((1)(2)(3))\ub3c4 \uac01 \ud56d\ubaa9\uc744 \uc904\ubc14\uafc8\uc73c\ub85c \ubd84\ub9ac\ud55c\ub2e4. \ub2e8, \ud55c \ubb38\uc7a5\uc73c\ub85c \uc790\uc5f0\uc2a4\ub7ec\uc6b4 \uc11c\uc220\uc740 \uc5b5\uc9c0\ub85c \ucabc\uac1c\uc9c0 \ub9d0 \uac83..\n   - \uadfc\uac70\ub97c \ubabb \ucc3e\uc740 \ud56d\ubaa9\uc740 value \ub97c \ube44\uc6b0\uace0 confidence=LOW, sourceQuote='' \ub85c \ub450\uc138\uc694. \uc808\ub300 \ucd94\uce21\uc73c\ub85c \ucc44\uc6b0\uc9c0 \ub9c8\uc138\uc694.\n\n[\uae08\uc9c0]\n- \uc774\ubbf8 \uc77d\uc740 \ud30c\uc77c\u00b7\ud398\uc774\uc9c0 \uc7ac\ub3c5 \uae08\uc9c0(\uc77d\uae30 \ub8e8\ud504 \ubc29\uc9c0). 1\ud68c\ub3c5 \ub05d\ub098\uba74 \uc989\uc2dc \ubd84\uc11d.\n- structured_output tool \ud638\ucd9c \uae08\uc9c0(\ub2e4\uc74c STEP \ub2f4\ub2f9).\n- \uadfc\uac70 \uc5c6\ub294 \uc0ac\uc2e4 \uc0dd\uc131 \uae08\uc9c0. \ube48\uce78\uc740 \ube48\uce78\uc73c\ub85c.\n\n[\ucd9c\ub825]\n\uc704 \ubd84\uc11d\uc744 \uc790\uc720 \ud14d\uc2a4\ud2b8\ub85c, \uadf8\ub9ac\uace0 fact \ubaa9\ub85d(key/value/sourceFile/sourceQuote/page/confidence)\uc744 \ube60\uc9d0\uc5c6\uc774.\n[\u2605\uacc4\uc57d\uae30\uac04 \ucd94\ucd9c \uc6d0\uce59\u2605] contractPeriod \ub294 PWS/\uc6d0\ubb38\uc5d0 \uba85\uc2dc\ub41c \uacc4\uc57d\uae30\uac04\u00b7\uc774\ud589\uae30\uac04(period of performance) \ubb38\uad6c\ub97c \uc6d0\ubb38 \ud45c\ud604 \uadf8\ub300\ub85c \ucd94\ucd9c\ud55c\ub2e4. \ub2e4\ub978 \ud56d\ubaa9\uc5d0\uc11c \ub04c\uc5b4\uc640 \ubcc0\ud658\ud558\uac70\ub098 \ucd94\uce21\uc73c\ub85c \ucc44\uc6b0\uc9c0 \uc54a\ub294\ub2e4. \uc6d0\ubb38\uc5d0 \ud574\ub2f9 \ubb38\uad6c\uac00 \uc5c6\uc73c\uba74 \ube48 \ubb38\uc790\uc5f4\ub85c \ub454\ub2e4 \u2014 \ub2e8 \ud0a4 \uc790\uccb4\ub294 \ubc18\ub4dc\uc2dc \ucd9c\ub825\ud55c\ub2e4.",
                    "timeout_ms": 600000,
                    "description": "USFK \uc815\ubd80\uc870\ub2ec \uacf5\uace0 \ubd84\uc11d \uc5d0\uc774\uc804\ud2b8 (\uc791\uc5c5\uc7a5 grep/read \uae30\ubc18, \uadfc\uac70 \ubd80\ucc29)",
                    "connection_id": "cli-runner-bidding-001"
                },
                "depends_on": [
                    "write_description",
                    "download_attachments"
                ]
            },
            {
                "id": "verify_and_gapcheck",
                "name": "\ubd84\uc11d \uacb0\uacfc \uac80\uc99d \uc911",
                "type": "AGENT_CALL",
                "config": {
                    "prompt": "\ub2f9\uc2e0\uc740 \uacf5\uace0 \ubd84\uc11d \uacb0\uacfc\ub97c \uac80\uc99d\ud558\ub294 \uac10\uc0ac\uc790\uc785\ub2c8\ub2e4. \uc774\uc804 \ub2e8\uacc4\uac00 \ucd94\ucd9c\ud55c \ubd84\uc11d\uacfc fact \ubaa9\ub85d\uc774 \uc791\uc5c5\uc7a5(workspace) \uc6d0\ubb38\uacfc \uc2e4\uc81c\ub85c \uc77c\uce58\ud558\ub294\uc9c0, \uadf8\ub9ac\uace0 \ube60\uc9c4 \ud544\uc218 \ud56d\ubaa9\uc774 \uc5c6\ub294\uc9c0 \uc810\uac80\ud569\ub2c8\ub2e4.\n\n[\uac80\uc99d \ub300\uc0c1 (\uc774\uc804 STEP \uc0b0\ucd9c\ubb3c)]\n{{extract_facts.output}}\n\n\n\n[\uc791\uc5c5\uc7a5]\n- `description.txt`(\uacf5\uace0 \ubcf8\ubb38) \uc640 `attachments/`(\ucca8\ubd80 \uc6d0\ubcf8) \ub97c \uc9c1\uc811 \uc5f4\uc5b4 \ub300\uc870\ud558\uc138\uc694. \ud544\uc694\ud558\uba74 \ud0a4\uc6cc\ub4dc\ub85c \uac80\uc0c9\ud574 \ud574\ub2f9 \ubd80\ubd84\uc744 \uc815\ub3c5\ud569\ub2c8\ub2e4.\n\n[\uc218\ud589]\n1. \ucda9\uc2e4\uc131 \uac80\uc99d: \uac01 fact \uc758 sourceQuote \uac00 \ud574\ub2f9 sourceFile(description.txt/attachments/) \uc5d0 \uc2e4\uc81c\ub85c \uc874\uc7ac\ud558\ub294\uc9c0 \ud655\uc778. \uc6d0\ubb38\uc5d0 \uc5c6\ub294\ub370 value \uac00 \ucc44\uc6cc\uc9c4 fact = \ud658\uac01 \u2192 \ud45c\uc2dc.\n2. \ub204\ub77d \uc810\uac80(Gap Check): USFK \uacf5\uace0 \ud544\uc218 \ud56d\ubaa9 \uccb4\ud06c\ub9ac\uc2a4\ud2b8\ub85c \ube60\uc9c4 \uac8c \uc5c6\ub294\uc9c0 \ud655\uc778 \u2014 \ub9c8\uac10\uc77c/\uc81c\ucd9c\ubc29\ubc95(PIEE \ub4f1)/\uacc4\uc57d\uae30\uac04(\uc218\ud589\uae30\uac04\u00b7\uc635\uc158\uc5f0\ucc28)/\ud3c9\uac00\uae30\uc900/\uc81c\ucd9c\uc11c\ub958 \ubcfc\ub968\u00b7\ud398\uc774\uc9c0\uc81c\ud55c/FACTOR \uad6c\uc870/POC/\ud604\uc7a5\uc124\uba85\ud68c \uc720\ubb34. \uc791\uc5c5\uc7a5 \uc6d0\ubb38\uc5d4 \uc788\ub294\ub370 \ucd94\ucd9c\uc5d0\uc11c \ube60\uc9c4 \ud56d\ubaa9 = \ub204\ub77d \u2192 \ud45c\uc2dc.\n3. \ucda9\uc871\uc8fc\uccb4 \uc7ac\ud655\uc778: CLIENT_UPLOAD \uc5ec\uc57c \ud560(\ud2b8\ub7ed\u00b7\uc778\ub825\u00b7\uc2e4\uc801) \ud56d\ubaa9\uc774 PLATFORM_GENERATED \ub85c \uc798\ubabb \ubd84\ub958\ub410\ub294\uc9c0 \uc810\uac80.\n\n[\ucd9c\ub825]\n{ verifiedFacts: [...\uc815\uc815\u00b7\ud655\uc815\ub41c fact \ubaa9\ub85d...], hallucinations: [\ud658\uac01\uc73c\ub85c \ud310\ub2e8\ud574 \uc81c\uac70/\uc218\uc815\ud55c \ud56d\ubaa9], gaps: [\uc6d0\ubb38\uc5d0 \uc788\uc73c\ub098 \ub204\ub77d\ub41c \ud56d\ubaa9 \u2014 \uac00\ub2a5\ud558\uba74 \uc791\uc5c5\uc7a5\uc5d0\uc11c \uac12 \ubcf4\uac15], notes: \uac80\uc99d \uc694\uc57d }. \uc815\uc815\ub41c \ucd5c\uc885 fact \ubaa9\ub85d\uacfc \ubd84\uc11d\uc744 \ub2e4\uc74c STEP \uc774 \uc4f8 \uc218 \uc788\uac8c \uc815\ub9ac\ud558\uc138\uc694.\n\u2605\ud544\uc218\u2605 verifiedFacts \uc758 \uac01 \ud56d\ubaa9\uc740 \uac80\uc99d \ub9c8\ud06c(\u2713/\uc815\ud655/\uc77c\uce58 \ub4f1)\ub9cc \ub0a8\uae30\uc9c0 \ub9d0\uace0 \ubc18\ub4dc\uc2dc \uc2e4\uc81c \uac12(value)\uc744 \uadf8\ub300\ub85c \ud3ec\ud568\ud558\ub77c. \uac01 \ud56d\ubaa9\uc740 { key, value(\uc2e4\uc81c \ucd94\ucd9c\uac12 \u2014 \uc808\ub300 \uc0dd\ub7b5 \uae08\uc9c0), sourceFile, sourceQuote, page, confidence } \ud615\ud0dc\uc5ec\uc57c \ud55c\ub2e4. \uac12\uc774 \ub9de\ub2e4\uace0 \ud310\ub2e8\ud588\uc73c\uba74 \uadf8 \uac12\uc744 \uadf8\ub300\ub85c \uc2e4\uc5b4\ub77c(\uc608: key='\uacf5\uace0\ubc88\ud638' value='W912xx-25-R-0001', key='\ubc1c\ud589\uc77c' value='2026-03-01'). value \ub97c \ube44\uc6b0\uac70\ub098 '\uc815\ud655\ud568' \uac19\uc740 \uac80\uc99d \ud45c\ud604\uc73c\ub85c \ub300\uccb4\ud558\uba74 \ub2e4\uc74c STEP \uc774 \uc2e4\uc81c \uac12\uc744 \uc783\ub294\ub2e4.\n\n[\u2605\ucd5c\uc885 \ucd9c\ub825 \u2014 \uad6c\uc870\ud654 (\ud544\uc218)\u2605]\n\uc704 \uac80\uc99d\uc744 \ub9c8\uce5c \ub4a4, \uadf8 \uacb0\uacfc\ub97c \uc544\ub798 response_schema \uc5d0 \ub9de\ucdb0 structured_output \uc73c\ub85c \uc81c\ucd9c\ud558\ub77c. \uc790\uc720 \ud14d\uc2a4\ud2b8\ub098 ```json \ucf54\ub4dc\ube14\ub85d\uc774 \uc544\ub2c8\ub77c structured_output \ub3c4\uad6c \ud638\ucd9c\ub85c \ub0b8\ub2e4. - verifiedFacts(\uc815\uc815\u00b7\ud655\uc815 fact, hallucinations \uc81c\uc678)\ub97c facts[] \ub85c \uadf8\ub300\ub85c \uc2e3\ub294\ub2e4(\uac01 {key,value,sourceFile,sourceQuote,page,confidence}, value \uc808\ub300 \ube44\uc6b0\uc9c0 \ub9d0 \uac83). - koreanTitle/summary/requiredDocuments(documents+factors+eligibility) \uae4c\uc9c0 schema \ub300\ub85c \ucc44\uc6b4\ub2e4. - \ubcf8\ubb38\uc5d0 \uc5c6\ub294 \uac12\uc740 \ube48 \ubb38\uc790\uc5f4\u00b7\ube48 \ubc30\uc5f4\ub85c \ub450\ub418 \uc139\uc158 \uace8\uaca9\uc740 \uc0ad\uc81c\ud558\uc9c0 \uc54a\ub294\ub2e4. \ucd94\uce21\uc73c\ub85c \ucc44\uc6b0\uc9c0 \uc54a\ub294\ub2e4.\n[\u2605\uacc4\uc57d\uae30\uac04 \ucd94\ucd9c \uc6d0\uce59\u2605] contractPeriod \ub294 PWS/\uc6d0\ubb38\uc5d0 \uba85\uc2dc\ub41c \uacc4\uc57d\uae30\uac04\u00b7\uc774\ud589\uae30\uac04(period of performance) \ubb38\uad6c\ub97c \uc6d0\ubb38 \ud45c\ud604 \uadf8\ub300\ub85c \ucd94\ucd9c\ud55c\ub2e4. \ub2e4\ub978 \ud56d\ubaa9(\ub0a9\ud488\uae30\ud55c \ub4f1)\uc5d0\uc11c \ub04c\uc5b4\uc640 \ubcc0\ud658\ud558\uac70\ub098 \ucd94\uce21\uc73c\ub85c \ucc44\uc6b0\uc9c0 \uc54a\ub294\ub2e4. \uc6d0\ubb38\uc5d0 \ud574\ub2f9 \ubb38\uad6c\uac00 \uc5c6\uc73c\uba74 \ube48 \ubb38\uc790\uc5f4\ub85c \ub454\ub2e4 \u2014 \ub2e8 \ud0a4 \uc790\uccb4\ub294 \ubc18\ub4dc\uc2dc \ucd9c\ub825\ud55c\ub2e4(\ud0a4 \uc0dd\ub7b5 \uae08\uc9c0).",
                    "timeout_ms": 600000,
                    "description": "\ucd94\ucd9c \uacb0\uacfc\ub97c \uc791\uc5c5\uc7a5 \uc6d0\ubb38\uacfc \ub300\uc870 \uac80\uc99d\ud558\ub294 Verifier/GapChecker",
                    "connection_id": "cli-runner-bidding-001",
                    "response_schema": {
                        "type": "object",
                        "required": [
                            "koreanTitle",
                            "summary",
                            "requiredDocuments"
                        ],
                        "properties": {
                            "facts": {
                                "type": "array",
