                      }
                    }
                  }
                },
                "eligibility": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "title": {
                        "type": "string"
                      },
                      "isGate": {
                        "type": "boolean"
                      },
