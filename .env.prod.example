# 운영 서버(/home/therecommerce/bidding-agency/.env) 샘플.
# 실제 .env 는 git 에 커밋하지 않는다(.gitignore). 서버에만 두고 chmod 600.
# docker-compose.prod.yml 이 이 값들을 ${VAR} 로 주입받으며, 값이 없으면 기동이 실패한다.

# MariaDB 접속 비밀번호
DB_PASSWORD=

# SAM.gov Public API Key (90일 만료 — 만료 시 SAM.gov > Account Details > Public API Keys 에서
# Remove 후 재발급받아 이 줄만 교체하고 `docker compose up -d --force-recreate bidding-agency`)
SAM_GOV_API_KEY=

# CR-144: Aimbase 가 /mcp 를 부를 때 싣는 열쇠. 서버에서 만들고(openssl rand -hex 32) 화면에 찍지 않는다.
# Aimbase 등록 bidding-agency-mcp 의 config.headers.X-API-Key 와 같은 값이어야 한다. 비면 /mcp 가 모두 막힌다
MCP_API_KEY=

# 로그인 서명 키. 서버에서 만들고(openssl rand -hex 48) 화면에 찍지 않는다. 바꾸면 로그인해 있던 사람은 모두 다시 로그인한다
JWT_SECRET=
